{
  "builds": [
    {
      "src": "api/data.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60, "includeFiles": "api/_*" }
    },
    {
      "src": "api/indexes.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60, "includeFiles": "api/_*" }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/data", "dest": "/api/data.py" },
    { "src": "/api/indexes", "dest": "/api/indexes.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
